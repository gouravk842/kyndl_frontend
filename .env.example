# Server
NODE_ENV=development

# Public (validated at build/runtime via config/env.ts)
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Object-store origin photos are uploaded to / served from (S3/MinIO bucket or
# CDN). Whitelisted in the CSP. Defaults to the local MinIO endpoint in dev.
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000
NEXT_PUBLIC_APP_NAME=Kyndl
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=true

# Auth note: tokens are delivered as httpOnly cookies set by the backend.
# In production the API must set them with `Secure` (HTTPS-only) + `SameSite`,
# and CORS must allow credentials from NEXT_PUBLIC_APP_URL. NEXT_PUBLIC_API_URL
# also scopes the CSP connect-src and the next/image remotePatterns.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
